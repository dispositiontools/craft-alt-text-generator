{% set selectedSubnavItem = 'errors' %}
{% extends "_layouts/cp" %}

{% set fullPageForm = true %}
{% set mainAttributes = {class: 'alt-text-generator-main' } %}


{% set footer %}
    <div id="count-container" class="light">Total errors: <strong>{{ totalRecords }}</strong></div>
    <div id="actions-container" class="flex"></div>
    <div id="export-container">
       {% for item in pagination %}
			{% if item.type == "Core"  %}
				<a href="{{ url ("alt-text-generator?offset="~item.offset) }}" style="padding:0px 10px;color:rgb(63, 77, 90); {% if item.current %}font-weight:bold;{% endif %}" >{{ item.label }}</a> 
			{% endif %}
		{% endfor %}
    </div>
{% endset %}
{% block content %}


<style>
	.pill{
		border-radius:8px;
		padding: 3px 10px;
		text-align:center;
		text-transform: uppercase;
		display:inline-text;
		background-color:#eee;
	}
	
	.alt-text-block{
		margin-bottom:5px;
		background-color:#f5f5f5;
		border-radius:10px;
		padding:5px 10px;
	}
	
	.alt-text-block label{

		
	}
	
		.alt-text-block-header{
		display:flex;
		justify-content:space-between;
	}

	.alt-text-block-actions label{
		white-space: nowrap;
	}

	.alt-text-block-textarea{
		width:100%;
	}

	.alt-text-block-actions label{
		white-space: nowrap;
	}

	.alt-text-edit-button{
		border-radius:8px;
		padding: 3px 10px;
		text-align:center;
		display:inline-text;
		background-color:#ccc;
		color:#fff;
		font-size:12px;
	}

	.alt-text-edit-button:hover{
		background-color:#aaa;
		color:#000;
	}
	.atg-spacer{
		width:100%;
		height:50px;
	}
</style>

{{ csrfInput() }}
{{ actionInput('alt-text-generator/cp/update-api-calls') }}

<h2>Errors</h2>

<p>
<a href="{{ url("alt-text-generator") }}">
View current items to review
</a>
</p>


{% set thumb = {
  mode: 'crop',
  width: 75,
  height: 75,
  quality: 75,
  position: 'top-center'
} %}
<div class="atg-spacer"></div>
<div class="tableview tablepane">
	<table class="data fullwidth">
		<thead>
			<tr>
				<th>Id</th>
				<th>Status</th>
				<th>Asset</th>
				<th>Alt text</th>
				<th>Actions</th>
				<th>Errors</th>
			</tr>
		</thead>
		<tbody>
		{% for apiCall in apiCalls %}
			{% include "alt-text-generator/_cp/_includes/apicall_table_row_error" %}
		{% endfor %}
		</tbody>
	</table>
</div>
{% endblock %}